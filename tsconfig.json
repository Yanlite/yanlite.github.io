{
  "extends": "astro/tsconfigs/strict",
  "include": ["./.astro/types.d.ts", "./**/*"],
  "compilerOptions": {
    // Basic
    "allowJs": true,
    // Building for a library
    "declaration": true,
    // Code runs in the DOM
    "lib": ["es2022", "dom", "dom.iterable"],
    // Type Imports
    "verbatimModuleSyntax": true,
    // Others
    "strictNullChecks": true,
    // Paths
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/public/*": ["./public/*"],
      "@/components/*": ["./src/components/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/utils": ["./src/utils/index.ts"],
      "@/utils/*": ["./src/utils/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/types": ["./src/types/index.ts"],
      "@/site-config": ["./src/site.config.ts"]
    }
    // https://docs.astro.build/en/guides/typescript/#typescript-editor-plugin
  },
  // packages/pure 是未参与当前应用导入的上游源码副本；实际主题依赖来自 node_modules。
  "exclude": [
    "./node_modules",
    "./**/node_modules/*",
    "./packages/pure",
    "./.vscode",
    "./dist",
    "./public/scripts/*",
    "./test/*"
  ]
}
