---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import ArticleList from '@/components/article/ArticleList.astro'
import { getArticleListing } from '@/utils/article-listing'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'
import { getArticleUrl } from '@/utils/articles'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const { collections, categoryCounts, collectionsCount } = await getArticleListing()
  const pages = paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { categoryCounts, collectionsCount }
  })

  // An article and a list page must not generate the same address.
  const pageIds = new Set(pages.map(({ params }) => params.page))
  for (const post of collections) {
    if (pageIds.has(post.id)) {
      throw new Error(`文章地址与列表分页冲突：${getArticleUrl(post.id)}。请修改文章 ID。`)
    }
  }

  return pages
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  categoryCounts: Map<string, number>
  collectionsCount: number
}

const { page, categoryCounts, collectionsCount } = Astro.props

const meta = {
  description: '文章列表与归档',
  title: '文章'
}


---

<PageLayout {meta}>
  <Button title='返回首页' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>文章</h1>
    </div>
    <ArticleList {page} {categoryCounts} {collectionsCount} />
  </main>
</PageLayout>
