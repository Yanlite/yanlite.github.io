---
import { ARTICLE_ROOT } from '@/utils/articles'
import PFSearch from '@/components/site/PFSearch.astro'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

const meta = {
  description: '搜索本站文章',
  title: '搜索'
}
---

<PageLayout {meta}>
  <Button title='返回文章列表' href={ARTICLE_ROOT} variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>搜索</h1>
    </div>

    <div id='content' class='animate'>
      {
        integ.pagefind ? (
          <>
            <p>输入关键词，搜索本站文章。</p>
            <PFSearch />
          </>
        ) : (
          <p>站内搜索暂未启用。</p>
        )
      }
    </div>
  </main>
</PageLayout>
