---
import { Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import config from '@/site-config'
import ProfileList from '@/components/about/ProfileList.astro'
import yanliteAvatar from '@/assets/yanlite.jpg'

const headings = [
  { depth: 2, slug: 'about-threlic', text: '关于 ThRelic' },
  { depth: 2, slug: 'author', text: '贡献者' },
  { depth: 2, slug: 'site-history', text: '站点时间线' }
]

// 本站历史待补充，每项填写 date 和 content；不沿用模板作者的事件。
const siteHistory: { date: string; content: string }[] = [
  {
    date: '2026-10-31',
    content: 'TODO'
  }
]
---

<PageLayout title='关于' {headings} comment>
  <h2 id='about-threlic'>关于 ThRelic</h2>
  <p>TODO</p>

  <h2 id='author'>贡献者</h2>
  <ProfileList list={[
    { name: config.author, avatar: yanliteAvatar, href: '/about/yanlite' }
  ]} />

  <h2 id='site-history'>站点时间线</h2>
  <Timeline events={siteHistory} />
</PageLayout>
