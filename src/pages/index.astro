---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import ContentLayout from '@/layouts/ContentLayout.astro'
import ArticleList from '@/components/article/ArticleList.astro'
import config from '@/site-config'
import { getArticleListing } from '@/utils/article-listing'
import { ARTICLE_ROOT } from '@/utils/articles'

const { collections, categoryCounts, collectionsCount } = await getArticleListing()
const size = config.content.blogPageSize ?? 10
const data = collections.slice(0, size)
const lastPage = Math.max(1, Math.ceil(collectionsCount / size))
// 首页作为文章第一页的入口，后续分页沿用 /article 的规范路径。
const page: Page<CollectionEntry<'blog'>> = {
  data,
  start: 0,
  end: data.length - 1,
  size,
  total: collectionsCount,
  currentPage: 1,
  lastPage,
  url: {
    current: '/',
    next: lastPage > 1 ? `${ARTICLE_ROOT}/2` : undefined,
    prev: undefined,
    first: undefined,
    last: lastPage > 1 ? `${ARTICLE_ROOT}/${lastPage}` : undefined
  }
}
const title = config.title
const description = config.description
---

<ContentLayout meta={{ title: '首页', description }} listing back={false}>
  <section slot='top' class='home-header animate' id='content-header'>
    <h1>{title}</h1>
    <p>{description}</p>
  </section>
  <ArticleList {page} {categoryCounts} {collectionsCount} />
</ContentLayout>

<style>
  .home-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: 3rem 2rem;
    text-align: center;
  }

  .home-header h1 {
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .home-header p {
    max-width: 42rem;
    color: hsl(var(--muted-foreground));
    overflow-wrap: anywhere;
  }
</style>
