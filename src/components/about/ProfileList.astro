---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

// 来源：Astro Theme Pure 的 links/FriendList.astro，Apache-2.0 许可（见仓库 LICENSE）。
// 改为通用人物数据、固定顺序、当前页跳转及可选的两行说明。
interface Profile {
  name: string
  description?: string
  avatar: ImageMetadata
  href: string
}

interface Props {
  list: Profile[]
}

const { list } = Astro.props
---

<div class='not-prose grid gap-3.5 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3'>
  {
    list.map((profile) => {
      const description = profile.description?.trim()
      return (
        <a href={profile.href} class='min-w-0 no-underline'>
          <div class='profile-card group relative h-full overflow-hidden rounded-2xl border bg-background px-2.5 py-1.5 transition-colors hover:bg-muted sm:px-4 sm:py-2'>
            <div class='relative z-10 flex h-full items-center gap-3'>
              {/* 头像和悬停箭头 */}
              <div class='profile-avatar relative h-14 w-14 min-w-14 overflow-hidden rounded-full'>
                <Image
                  class='profile-photo relative z-10 my-0 h-full w-full object-cover'
                  src={profile.avatar}
                  height={80}
                  width={80}
                  alt={`${profile.name}的头像`}
                  loading='lazy'
                  onload="this.dataset.loaded = 'true'; this.removeAttribute('data-failed')"
                  onerror="this.dataset.failed = 'true'; this.removeAttribute('data-loaded')"
                />
                {/* 仅在加载失败时显示轮廓，不让快速加载的图片闪出占位。 */}
                <div class='profile-placeholder absolute inset-0 flex items-center justify-center' aria-hidden='true'>
                  <svg width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'>
                    <circle cx='12' cy='8' r='3.25' />
                    <path d='M5.5 20v-1.5a6.5 6.5 0 0 1 13 0V20' stroke-linecap='round' />
                  </svg>
                </div>
                <div class='absolute inset-0 z-20 flex items-center justify-center rounded-full bg-foreground opacity-0 transition-opacity duration-300 group-hover:opacity-50'>
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    width='32'
                    height='32'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke-width='2.5'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    class='me-2 stroke-background'
                    aria-hidden='true'
                  >
                    <line x1='5' y1='12' x2='19' y2='12' class='translate-x-4 scale-x-0 transition-all duration-300 group-hover:translate-x-1 group-hover:scale-x-100' />
                    <polyline points='12 5 19 12 12 19' class='transition-transform duration-300 group-hover:translate-x-1' />
                  </svg>
                </div>
              </div>

              {/* 固定 56px：昵称 20px + 间距 4px + 两行说明 32px。 */}
              <div class:list={['flex h-14 min-w-0 flex-1 flex-col gap-y-1', description ? 'justify-start' : 'justify-center']}>
                <p class='my-0 line-clamp-1 text-sm leading-5'>{profile.name}</p>
                {description && (
                  <p class='my-0 line-clamp-2 break-words text-xs leading-4 text-muted-foreground'>
                    {description}
                  </p>
                )}
              </div>
            </div>

            {/* 装饰性头像背景，沿用友链卡片的渐隐效果。 */}
            <Image
              class='profile-photo profile-backdrop absolute -start-2 top-0 z-0 my-0 h-full w-2/3 bg-white object-cover'
              src={profile.avatar}
              height={80}
              width={80}
              alt=''
              loading='lazy'
              onload="this.dataset.loaded = 'true'; this.removeAttribute('data-failed')"
              onerror="this.dataset.failed = 'true'; this.removeAttribute('data-loaded')"
              style={{ maskImage: 'linear-gradient(to left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)' }}
            />
          </div>
        </a>
      )
    })
  }
</div>

<style>
  /* 保留语义 alt，避免浏览器的替代文字挤入圆形头像。 */
  .profile-card :global(.profile-photo) {
    color: transparent;
    font-size: 0;
    opacity: 0;
  }

  .profile-card :global(.profile-photo[data-loaded]) {
    opacity: 1;
  }

  /* 主题色由站点配置的 CSS 变量提供，不单独硬编码紫色。 */
  .profile-placeholder {
    border-radius: 50%;
    background-color: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
    opacity: 0;
  }

  .profile-card :global(.profile-photo[data-failed]) {
    opacity: 0;
  }

  .profile-avatar :global(.profile-photo[data-failed]) + .profile-placeholder {
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .profile-card :global(.profile-backdrop[data-loaded]) {
    opacity: 0.15;
  }

  .profile-card :global(.profile-backdrop[data-failed]) {
    opacity: 0;
  }
</style>
