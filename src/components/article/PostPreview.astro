---
// Adapted from astro-pure 1.4.9 (cworld1/astro-theme-pure), Apache-2.0; see LICENSE.
// 项目改动：统一文章链接，分类路径独立于文章主链接，最多显示两条。
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { render, type CollectionEntry, type CollectionKey } from 'astro:content'

import { getArticleUrl } from '@/utils/articles'
import CategoryPath from '@/components/category/CategoryPath.astro'

import { cn } from 'astro-pure/utils'
import { FormattedDate, Icon } from 'astro-pure/user'

// 组件输入：文章数据、是否显示详细信息，以及调用方追加的样式类。
type Props<T extends CollectionKey> = {
  post: CollectionEntry<T>
  detailed?: boolean
  class?: string
}

// 展示数据准备：读取文章，取得阅读时长，并优先使用更新日期。
const { post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate

// 可选资料的类型说明：封面、语言和置顶状态并非每个内容集合都有。
type PreviewMetadata = {
  heroImage?: {
    src: ImageMetadata
    alt?: string
    inferSize?: boolean
    width?: number
    height?: number
    color?: string
  }
  language?: string
  pin?: boolean
}
const previewData = data as typeof data & Partial<PreviewMetadata>

// 分类展示数据：按填写顺序取前两项，保留文章的完整归属供查询和统计。
const categoryIds = ('categories' in data ? data.categories : []).slice(0, 2)
---

{/* 卡片列表项：接收外部样式，并为封面对应的悬停配色提供 CSS 变量。 */}
<li
  class={cn('post-preview', className)}
  style={detailed &&
    previewData.heroImage?.color &&
    `--preview-highlight:color-mix(in srgb,${previewData.heroImage.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)));
    --preview-highlight-bg:hsl(from ${previewData.heroImage.color} h s l/20%)`}
>
  {/* 卡片外观与定位容器：负责边框、内边距，并在窄屏为顶部封面预留空间。 */}
  <div
    class={cn(
      'post-card block w-full relative group rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted hover:text-primary',
      detailed && 'max-sm:px-4 sm:py-5',
      detailed && previewData.heroImage && 'max-md:pt-24'
    )}
  >
  {/* 详细卡片的分类行：显示文件夹与灰色路径；简版省略，独立链接盖在封面上方。 */}
  {detailed && categoryIds.length > 0 && (
    <ul
      aria-label='文章分类'
      class='category-list relative mb-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground'
      style='z-index:1'
    >
      {categoryIds.map((categoryId: string) => (
        <li class='flex min-w-0 items-center gap-1.5'>
          <svg
            aria-hidden='true'
            class='size-4 shrink-0'
            viewBox='0 0 24 24'
            fill='currentColor'
          >
            <path d='M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v1H6.5a2 2 0 0 0-1.9 1.4L2 19V7Z' />
            <path d='M6.5 11H22l-3.1 8.3a1 1 0 0 1-.9.7H3.5l2.1-8.3a1 1 0 0 1 .9-.7Z' />
          </svg>
          <CategoryPath {categoryId} />
        </li>
      ))}
    </ul>
  )}
  {/* 文章主链接：图片和正文信息都可进入文章，与上方分类行分开。 */}
  {/* 定位约束：主链接保持静态定位，使封面尺寸以整张 post-card 为参照。 */}
  <a
    class='article-link block'
    href={getArticleUrl(id)}
    data-astro-prefetch
  >
    {/* 详细卡片封面：绝对定位到整张卡片，宽高比例随屏幕尺寸调整。 */}
    {
      detailed && previewData.heroImage && (
        <Image
          alt={previewData.heroImage.alt || data.title}
          class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70 md:h-full md:w-3/5'
          loading='eager'
          {...previewData.heroImage}
        />
      )
    }
    {/* 正文信息层：盖在封面上方；简版卡片在较宽屏幕上横向排列日期与标题。 */}
    <div
      class={cn('relative flex flex-col gap-1', !detailed && 'sm:flex-row sm:items-center')}
      style='z-index:1'
    >
      {postDate && <FormattedDate class='min-w-[95px] text-xs' date={postDate} />}

      {/* 文章标题与状态：显示置顶、草稿标记，以及提示跳转的箭头。 */}
      <div class='flex justify-between flex-grow'>
        <div class={cn(detailed && 'font-medium')}>
          {previewData.pin && <span class='text-primary me-1'>[置顶]</span>}
          {data.draft && <span class='text-red-500 me-1'>（草稿）</span>}
          {data.title}
        </div>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='preview-redirect my-1 stroke-muted-foreground group-hover:stroke-primary'
          ><line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          ></line><polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          ></polyline></svg
        >
      </div>
      {/* 详细信息区域：简版卡片省略摘要、阅读时长和语言。 */}
      {
        detailed && (
          <>
            {/* 文章摘要：限制显示行数，避免长文本撑满卡片。 */}
            <p
              class={cn(
                'line-clamp-2 text-sm text-muted-foreground sm:line-clamp-3',
                previewData.heroImage && 'sm:me-24'
              )}
            >
              {data.description}
            </p>
            <div class='py-2 flex items-center gap-2 text-sm italic leading-4 text-muted-foreground'>
              {/* 阅读时长：显示 Markdown 渲染时提取的估算值。 */}
              <span class='flex items-center gap-1'>
                <Icon name='time' class='size-4' />
                {String(remarkPluginFrontmatter.minutesRead ?? '').replace(/ min$/, ' 分钟')}
              </span>
              {/* 文章语言：仅在文章提供语言资料时显示。 */}
              {previewData.language && (
                <span class='flex items-center gap-1'>
                  <Icon name='earth' class='size-4' />
                  {previewData.language}
                </span>
              )}
            </div>
          </>
        )
      }
    </div>
  </a>
  </div>

  <style>
    /* 悬停颜色的默认值：没有封面配色时使用站点主题色。 */
    .post-preview {
      --preview-highlight-final: var(
        --preview-highlight,
        hsl(var(--primary) / var(--un-text-opacity, 1))
      );
    }
    /* 卡片悬停反馈：同步调整背景、文章链接、分类链接和跳转箭头的颜色。 */
    .post-preview:hover {
      & > .post-card {
        background-color: var(
          --preview-highlight-bg,
          hsl(var(--muted) / var(--un-bg-opacity, 1))
        ) !important;
      }
      & .article-link,
      & :global(.category-list a:hover) {
        color: var(--preview-highlight-final) !important;
      }
      & .preview-redirect {
        stroke: var(--preview-highlight-final) !important;
      }
    }
    /* 宽屏封面遮罩：从左侧透明过渡到右侧可见，减轻图片对文字的干扰。 */
    .cover-image {
      -webkit-mask-image: -webkit-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    }

    /* 窄屏封面遮罩：改为上方可见、下方渐隐，配合封面位于卡片顶部的布局。 */
    @media (max-width: 768px) {
      .cover-image {
        -webkit-mask-image: -webkit-linear-gradient(
          bottom,
          rgba(0, 0, 0, 0) 0%,
          rgba(0, 0, 0, 1) 100%
        );
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      }
    }
  </style>
</li>
